{
  "name": "gratia",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "A stubbornly opinionated starter template for NextJS projects.",
  "author": "Clover You <hi@clovu.me>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/clovu/starter-nextjs.git"
  },
  "homepage": "https://github.com/clovu/starter-nextjs",
  "bugs": "https://github.com/clovu/starter-nextjs/issues",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm type-check && next build",
    "start": "next start",
    "lint": "eslint",
    "fix": "eslint --fix",
    "type-check": "tsgo --noEmit",
    "prepare": "simple-git-hooks"
  },
  "engines": {
    "node": ">=23.6.0"
  },
  "dependencies": {
    "@formatjs/intl-localematcher": "^0.8.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "glob": "^13.0.6",
    "lucide-react": "^1.14.0",
    "negotiator": "^1.0.0",
    "next": "16.2.7",
    "next-intl": "^4.13.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "shadcn": "^4.10.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@iconify-json/carbon": "^1.2.20",
    "@iconify/tailwind4": "^1.2.3",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/negotiator": "^0.6.4",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260602.1",
    "@vercel/config": "^0.5.2",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^10.4.1",
    "eslint-config-next": "16.2.9",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "lint-staged": "^17.0.7",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm type-check && pnpm lint-staged --config lint-staged.config.ts"
  }
}
